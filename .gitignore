# Secrets - never commit
.env
.env.*
!.env.example

# Serena / editor
.serena/
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
