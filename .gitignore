# Runtime state (SQLite is the transactional source of truth, not versioned)
data/store/
*.db
*.db-journal

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# OS
.DS_Store
Thumbs.db

# Local UI captures, kept out of the tree. Real README screenshots are taken
# from a live run and committed deliberately, not by a glob.
.screenshots/

# Working notes. Not documentation, and not something to publish by accident.
.plan.md
