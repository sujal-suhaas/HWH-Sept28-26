# DejaOps environment configuration.
# Copy to .env and fill in real values. Never commit .env.
# Keep this file LF-only: CRLF breaks shell sourcing of tokens.

# --- GitHub (build/release automation only; not read by the app) ---
# Fine-grained PAT for Member A (repo owner). Needs Contents RW, Issues RW,
# Pull requests RW, Administration RW, Workflows RW on this repository.
GH_TOKEN_A=ghp_placeholder_member_a
# Fine-grained PAT for Member B. Needs Contents RW, Issues RW, Pull requests RW,
# Workflows RW on this repository.
GH_TOKEN_B=ghp_placeholder_member_b
# Used only as the git author/committer identity by scripts/git-as.sh.
MEMBER_A_NAME=Member A Name
MEMBER_A_EMAIL=member-a@example.com
MEMBER_B_NAME=Member B Name
MEMBER_B_EMAIL=member-b@example.com

# --- Hindsight (required memory layer) ---
# Created from the Hindsight Cloud connection flow, or any Hindsight deployment.
HINDSIGHT_API_KEY=hsk_placeholder
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Dedicated Memory Bank for the deployed DejaOps workspace.
HINDSIGHT_BANK_ID=dejaops-prod
HINDSIGHT_TIMEOUT_SECONDS=30
HINDSIGHT_MAX_RETRIES=3
HINDSIGHT_BACKOFF_BASE_SECONDS=0.5
# Recall results below this final score are treated as "no relevant memory".
# Calibrated on the seeded NimbusPay bank: relevant top scores 0.353-1.087,
# irrelevant top scores 0.000-0.089.
HINDSIGHT_MIN_FINAL_SCORE=0.2

# --- Memory mode ---
# on  -> recall/retain against Hindsight
# off -> no Hindsight calls at all (comparison runs)
MEMORY_MODE=on

# --- Groq (LLM) ---
GROQ_API_KEY=gsk_placeholder
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=60
# Retries per model on retryable failures (429, 5xx, timeout, connection).
# A permanent failure such as a decommissioned model is never retried.
GROQ_MAX_RETRIES=2
GROQ_BACKOFF_BASE_SECONDS=0.5

# --- Agent loop ---
# Hard bound on model turns per run, so a looping model cannot run forever.
# Measured: the primary model issues roughly one tool call per turn, so a full
# investigate -> diagnose -> propose sequence needs about 6 turns.
AGENT_MAX_STEPS=8

# --- Local storage / API ---
SQLITE_PATH=data/store/dejaops.db
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
